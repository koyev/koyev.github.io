{
  "scripts": [
    {
      "in": "src/scripts/script.js",
      "out": "dist/scripts/script.js",
      "options": {
        "sourcemap": true,
        "minify": true,
        "justMinified": false,
        "format": "iife"
      }
    }
  ],
  "styles": [
    {
      "in": "src/styles/index.scss",
      "out": "dist/styles/style.css",
      "options": {
        "sourcemap": true,
        "minify": true,
        "justMinified": false
      }
    }
  ],
  "copy": [
    {
      "in": "src/static",
      "out": "dist"
    }
  ],
  "markup": {
    "in": "src/markup",
    "out": "dist",
    "options": {
      "site": {
        "title": "Marko Jevic Koyev - Software Engineer",
        "description": "Personal website and portfolio of Marko Jevic Koyev, a software engineer.",
        "url": "https://markojevic.com",
        "lang": "en",
        "author": "Marko Jevic"
      },
      "includePaths": ["_layouts", "_partials"],
      "dateFormat": "MMM D, YYYY",
      "sitemap": "sitemap.xml",
      "robots": "robots.txt",
      "llms": "llms.txt"
    }
  },
  "banner": "/* {{ name }} v{{ version }} | {{ homepage }} | {{ license }} License */",
  "serve": {
    "port": 4040
  },
  "livereload": true,
  "watch": ["src"],
  "includePaths": ["node_modules"]
}
